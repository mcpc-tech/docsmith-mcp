{
  "name": "docsmith-mcp",
  "version": "0.0.2",
  "description": "Python-powered document processing MCP for Excel, Word, PDF",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bin": {
    "docsmith-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "python",
    "scripts"
  ],
  "scripts": {
    "build": "tsdown && npm run build:ui",
    "build:ui": "vite build",
    "dev": "tsdown --watch",
    "dev:server": "tsx src/server-http.ts",
    "prepare": "pnpm build",
    "postinstall": "node --experimental-wasm-stack-switching scripts/preload-packages.mjs || true",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui"
  },
  "keywords": [
    "mcp",
    "document",
    "excel",
    "word",
    "pdf"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@mcpc-tech/code-runner-mcp": "0.1.8",
    "@modelcontextprotocol/ext-apps": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.25.3",
    "cors": "^2.8.5",
    "express": "^5.0.0",
    "zod": "3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.3",
    "@vitest/ui": "^4.0.18",
    "autoprefixer": "^10.4.24",
    "lucide-react": "^0.563.0",
    "postcss": "^8.5.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.1.18",
    "tsdown": "^0.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.2.0",
    "vitest": "^4.0.18"
  }
}
